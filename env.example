# Copy to .env.local (local) and add the same variables in Netlify:
# Site configuration > Environment variables

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase Dashboard > Project Settings > API Keys > "Publishable key".
# Replaces the legacy "anon" key. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional. Public address of the site, used for sitemap.xml, robots.txt and canonical links.
# On Netlify you can leave this out: the built-in URL variable is used automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# NOTE: no secret / service-role key is needed (or used) any more.
# You can delete SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY from .env.local and Netlify.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is still read as a fallback only; rename it to the publishable one.
